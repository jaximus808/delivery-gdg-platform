# Copy to deployments/.env — never commit the real file.

# Supabase project (shared by authoritative + web)
SUPABASE_URL=https://xxxx.supabase.co
# anon/public key — used by the Go authoritative server
SUPABASE_KEY=
# service-role key — used by the Next.js API routes (server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# Signs the auth-token cookie issued by /api/signin
JWT_SECRET=change-me

# Prod only (docker-compose.prod.yml / Caddy)
DOMAIN_NAME=example.com
