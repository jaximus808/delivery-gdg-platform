# Copy to deployments/.env — never commit the real file.
# Supabase now issues "publishable" (sb_publishable_...) and "secret" (sb_secret_...)
# API keys in place of the legacy anon / service_role JWTs.

# Supabase project (shared by authoritative + web)
SUPABASE_URL=https://xxxx.supabase.co
# secret key (sb_secret_...) — server-side only. Used by the Go authoritative
# server and by the Next.js API routes. Bypasses RLS; never ship it to a browser.
SUPABASE_SECRET_KEY=
# publishable key (sb_publishable_...) — safe for clients. Not used by the
# current web build (it talks to the DB only via server routes); reserved for
# the auth example in apps/authoritative and any future client-side Supabase.
SUPABASE_PUBLISHABLE_KEY=

# Signs the auth-token cookie issued by /api/signin
JWT_SECRET=change-me

# Prod only (docker-compose.prod.yml / Caddy)
DOMAIN_NAME=example.com
